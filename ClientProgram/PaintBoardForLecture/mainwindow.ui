   <string notr="true">
/* ── Toolbar ─────────────────────────────────── */
QToolBar {
    background-color: #1a1a1a;
    border: none;
    border-bottom: 1px solid #2d2d2d;
    spacing: 4px;
    padding: 3px 8px;
}

QToolBar QToolButton {
    background-color: transparent;
    color: #888888;
    border: none;
    border-radius: 5px;
    padding: 5px 16px;
    font-size: 12px;
    font-weight: 600;
    min-width: 54px;
    min-height: 26px;
}

QToolBar QToolButton:hover {
    background-color: #2d2d2d;
    color: #e0e0e0;
}

QToolBar QToolButton:checked {
    background-color: #0d6efd;
    color: #ffffff;
}

/* ── Side panel ──────────────────────────────── */
#sidePanelWidget {
    background-color: #1a1a1a;
    border-left: 1px solid #2d2d2d;
}

/* ── Section labels ──────────────────────────── */
QLabel {
    color: #555555;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
}

/* ── Color picker button ─────────────────────── */
#colorPickerButton {
    background-color: #222222;
    color: #888888;
    border: 1px solid #333333;
    border-radius: 5px;
    font-size: 11px;
    font-weight: 600;
    min-height: 30px;
    text-align: center;
}

#colorPickerButton:hover {
    background-color: #2a2a2a;
    border-color: #555555;
    color: #cccccc;
}

/* ── Separator ───────────────────────────────── */
QFrame#separator {
    color: #2d2d2d;
}

/* ── Line edit ───────────────────────────────── */
QLineEdit {
    background-color: #222222;
    color: #cccccc;
    border: 1px solid #333333;
    border-radius: 4px;
    padding: 3px 6px;
    font-size: 12px;
    selection-background-color: #0d6efd;
}

QLineEdit:focus {
    border-color: #0d6efd;
}

/* ── Slider ──────────────────────────────────── */
QSlider::groove:horizontal {
    height: 3px;
    background: #2d2d2d;
    border-radius: 2px;
    margin: 0;
}

QSlider::handle:horizontal {
    background: #0d6efd;
    border: none;
    width: 14px;
    height: 14px;
    margin: -6px 0;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background: #5aabff;
}

QSlider::sub-page:horizontal {
    background: #0d6efd;
    border-radius: 2px;
    height: 3px;
}

/* ── Status bar ──────────────────────────────── */
QStatusBar {
    background-color: #007acc;
    color: #ffffff;
    font-size: 11px;
    padding: 1px 8px;
}

/* ── Menus ───────────────────────────────────── */
QMenu {
    background-color: #1e1e1e;
    color: #cccccc;
    border: 1px solid #333333;
    padding: 4px 0;
}

QMenu::item {
    padding: 6px 20px;
    font-size: 12px;
}

QMenu::item:selected {
    background-color: #0d6efd;
    color: #ffffff;
}
   </string>
