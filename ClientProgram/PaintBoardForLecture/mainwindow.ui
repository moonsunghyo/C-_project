  <property name="styleSheet">
   <string notr="true">
QMainWindow {
    background-color: #1e1e1e;
}

QWidget#centralwidget {
    background-color: #1e1e1e;
}

/* ── Side Panel ── */
QWidget#horizontalLayoutWidget {
    background-color: #1e1e1e;
}

/* ── Menu ── */
QMenuBar {
    background-color: #252526;
    color: #cccccc;
    border-bottom: 1px solid #3c3c3c;
    padding: 2px 4px;
    font-size: 13px;
}
QMenuBar::item {
    padding: 4px 10px;
    border-radius: 4px;
}
QMenuBar::item:selected {
    background-color: #37373d;
    color: #ffffff;
}
QMenu {
    background-color: #252526;
    color: #cccccc;
    border: 1px solid #3c3c3c;
    border-radius: 6px;
    padding: 4px;
}
QMenu::item {
    padding: 6px 20px;
    border-radius: 4px;
}
QMenu::item:selected {
    background-color: #094771;
    color: #ffffff;
}

/* ── Toolbar ── */
QToolBar {
    background-color: #252526;
    border-bottom: 1px solid #3c3c3c;
    spacing: 4px;
    padding: 3px 6px;
}
QToolBar::separator {
    background-color: #3c3c3c;
    width: 1px;
    margin: 4px 6px;
}
QToolButton {
    background-color: transparent;
    color: #cccccc;
    border: none;
    border-radius: 5px;
    padding: 5px 14px;
    font-size: 13px;
}
QToolButton:hover {
    background-color: #37373d;
    color: #ffffff;
}
QToolButton:pressed, QToolButton:checked {
    background-color: #094771;
    color: #ffffff;
}

/* ── Color Picker Button ── */
QPushButton#colorPickerButton {
    background-color: #3c3c3c;
    color: #cccccc;
    border: 1px solid #555555;
    border-radius: 6px;
    padding: 8px 0px;
    font-size: 13px;
    font-weight: 600;
}
QPushButton#colorPickerButton:hover {
    background-color: #4a4a4a;
    border-color: #6a6a6a;
    color: #ffffff;
}
QPushButton#colorPickerButton:pressed {
    background-color: #2a2a2a;
}

/* ── Labels ── */
QLabel {
    color: #9d9d9d;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
}

/* ── Slider ── */
QSlider::groove:horizontal {
    height: 4px;
    background-color: #3c3c3c;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    background-color: #0e7fd4;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}
QSlider::handle:horizontal:hover {
    background-color: #1b9aff;
}
QSlider::sub-page:horizontal {
    background-color: #0e7fd4;
    border-radius: 2px;
}

/* ── Line Edit ── */
QLineEdit {
    background-color: #2d2d2d;
    color: #cccccc;
    border: 1px solid #3c3c3c;
    border-radius: 5px;
    padding: 4px 6px;
    font-size: 13px;
    selection-background-color: #094771;
}
QLineEdit:focus {
    border-color: #0e7fd4;
}

/* ── Status Bar ── */
QStatusBar {
    background-color: #007acc;
    color: #ffffff;
    font-size: 12px;
}
   </string>
